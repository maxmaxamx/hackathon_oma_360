DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# AI gateway (OpenAI-compatible). Without a working key the app uses deterministic fallbacks.
AI_BASE_URL="https://opencode.ai/inference/openai/v1"
AI_API_KEY=""
# Text model, for example deepseek-v4.1-flash (OpenCode Go)
# or deepseek-v4.1-flash-free (free quota, if available).
AI_TEXT_MODEL="deepseek-v4.1-flash"
# Optional reasoning effort for reasoning models: low | medium | high
AI_REASONING_EFFORT="low"
# Image generation is optional but required for room previews.
# DeepSeek is text-only, so set a separate image model here.
AI_IMAGE_MODEL=""

# OMA catalog
OMA_BASE_URL="https://www.oma.by"
OMA_CITY_ID="8019"
OMA_LOCATION_ID="432550"
USE_MOCK_CATALOG="false"
